{
  "name": "macthing",
  "version": "0.2.4",
  "private": true,
  "description": "MacThing — a Spotify Car Thing as a Now Playing display + volume knob for macOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srcurran/MacThing.git"
  },
  "homepage": "https://github.com/srcurran/MacThing",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:ui && ./native/build.sh",
    "build:ui": "vite build",
    "prestart": "npm run build:ui",
    "start": "node bridge/main.js",
    "predev": "npm run build:ui",
    "dev": "DEBUG=1 node bridge/main.js --watch",
    "screenshot": "node scripts/screenshot.js",
    "mock-screens": "node scripts/mock-screens.js",
    "setup-device": "./scripts/setup-device.sh",
    "restore-device": "./scripts/restore-device.sh",
    "preinstall-agent": "npm run build:ui",
    "install-agent": "./scripts/launch-agent.sh install",
    "uninstall-agent": "./scripts/launch-agent.sh uninstall",
    "prerestart": "npm run build:ui",
    "restart": "./scripts/launch-agent.sh restart",
    "status": "./scripts/launch-agent.sh status",
    "logs": "./scripts/launch-agent.sh logs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.3"
  }
}
